# Secrets — never commit
keystore.properties
keystore/

# Gradle
.gradle/
build/
app/build/
local.properties

# Cargo / Rust. `engine/target/` is ~100 MB of debug binaries and incremental
# caches, regenerated by `cargo build`. It also embeds the absolute path of
# whichever machine compiled it, so publishing it leaks the maintainer's home
# directory into the repository.
target/
engine/target/

# IDE
.idea/
*.iml
.DS_Store
tools/captures/

# Build outputs that land in the source tree.
# `libdroidvault_engine.so` is produced by the `buildRustEngine*` tasks from
# engine/src — committing it puts a stale, machine-specific binary in the tree
# and makes diffs enormous. It is NOT ignored by a blanket `*.so`: `libzapdos.so`
# next to it is a VENDORED input with no source in this repository, so it must
# stay tracked or the build cannot work.
app/src/main/jniLibs/*/libdroidvault_engine.so

# Scratch output from a release build.
rel8.log

# Local tool state.
.freebuff/
.kotlin/

# ---------------------------------------------------------------------------
# Local working material — kept on disk, never published.
#
# These are the maintainer's own notes and local test artefacts, not project
# documentation. They assume the reader has the test device, the reference
# hardware and the full session history in front of them, so publishing them
# would confuse a contributor rather than help one.
#
#   AGENTS.md, AUDIT.md — local engineering notes: invariants, device mechanics,
#                build traps, and a defect log tied to one device.
#   evidence/  — before/after screenshots from a local restore test.
#   design/    — working design comps (dark / light / no-background).
#   screenshots/ — store-listing art kept locally.
#   tools/     — the capture.sh screen-grabbing harness used for device
#                verification, plus its captures/. Not needed to build.
#
# None of it is needed to build, test or ship the app.
# ---------------------------------------------------------------------------
AGENTS.md
AUDIT.md
evidence/
design/
screenshots/
tools/

# The engine's pre-Rust shell backend, kept locally for reference while
# comparing protocol behaviour. Nothing compiles or reads it.
engine/legacy/

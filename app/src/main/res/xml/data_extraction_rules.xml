<?xml version="1.0" encoding="utf-8"?>
<!--
  No cloud/device-to-device backup of app data: prefs here hold only
  operational state (paths, consent gates, pending SMS-handback markers) that
  must never ride a device transfer or cloud restore (matches the offline
  trust model).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
